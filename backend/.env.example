NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
# Use Atlas or an initialized local replica set (transactions are required).
MONGODB_URI=mongodb://127.0.0.1:27017/freelancer_project_income_tracker?replicaSet=rs0
# Required: replace with a cryptographically random private value of at least 32 bytes.
# Never reuse this example placeholder or expose the secret in frontend variables.
JWT_SECRET=replace-with-a-private-random-secret
# Explicit units required: s, m, h, or d. Allowed range: 1 second through 7 days.
JWT_EXPIRES_IN=15m
